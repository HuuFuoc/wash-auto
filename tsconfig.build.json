{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Pin the output root: without this, any .ts outside src/ (e.g. scripts/)
    // shifts emit to dist/src/*, breaking `node dist/server.js` and the
    // copyfiles yaml step that swagger.ts reads from dist/docs/.
    "rootDir": "src",
    // Keep the incremental cache inside dist so a clean (delete dist) also
    // resets it; without this it lands at the repo root, untracked.
    "tsBuildInfoFile": "./dist/tsconfig.build.tsbuildinfo"
  },
  "exclude": ["node_modules", "test", "dist", "scripts", "**/*spec.ts"]
}
