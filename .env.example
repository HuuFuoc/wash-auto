# --- App ---
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
GLOBAL_API_PREFIX=api

# --- MongoDB Atlas ---
DB_USERNAME=
DB_PASSWORD=
DB_HOST=cluster0.mongodb.net
DB_NAME=washauto

# --- Redis ---
REDIS_URL=rediss://default:<password>@<host>:6380

# --- JWT (each secret MUST be at least 32 chars) ---
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL=7d
JWT_VERIFIED_EMAIL_SECRET=         # DIFFERENT from JWT_ACCESS_SECRET
JWT_VERIFIED_EMAIL_TTL=15m
BCRYPT_SALT_ROUNDS=12

# --- OTP ---
OTP_TTL_SECONDS=300
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_PER_EMAIL_COOLDOWN_SECONDS=60
OTP_PER_EMAIL_HOURLY_LIMIT=5
OTP_VERIFIED_EMAIL_SKIP_DAYS=7

# --- Email (Gmail SMTP App Password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Wash-Auto <no-reply@washauto.vn>"

# --- PayOS ---
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=http://localhost:5173/payment/success
PAYOS_CANCEL_URL=http://localhost:5173/payment/cancel

# --- Booking ---
MAX_ACTIVE_BOOKINGS_PER_CUSTOMER=3
MAX_RESCHEDULES=2
BOOKING_PAYMENT_TIMEOUT_MINUTES=15
IDEMPOTENCY_TTL_SECONDS=86400
