# Copy to `.env` and fill in. Never commit the real .env.
# Keys mirror what src/config/index.ts actually reads — nothing else is used.

# ---------- App ----------
PORT=3000
NODE_ENV=development
GLOBAL_API_PREFIX=api

# ---------- MongoDB Atlas ----------
DB_USERNAME=
DB_PASSWORD=
DB_HOST=
DB_NAME=

# ---------- Redis ----------
# Used by: rate-limit, idempotency, refresh tokens, and the Socket.IO Redis
# adapter (see SOCKET_REDIS_* below).
REDIS_URL=

# ---------- Auth (JWT) ----------
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL=7d
BCRYPT_SALT_ROUNDS=12

# ---------- Realtime (Socket.IO — src/core/realtime.ts) ----------
# All three are optional; the defaults below are what the code assumes when the
# variable is absent, so an existing deployment needs no change.
#
# Reject a handshake that carries no token. Every emit targets an authenticated
# room, so an anonymous socket can never receive anything — keep this false
# unless a client genuinely must connect before login.
SOCKET_ALLOW_ANONYMOUS=false
# Attach the Socket.IO Redis adapter so emits reach sockets held by OTHER
# instances. Requires REDIS_URL; without it the server still boots, but in
# single-instance mode.
SOCKET_REDIS_ENABLED=true
# Fail fast at startup if the adapter cannot be attached. Turn on for a
# multi-instance production; leave false locally.
SOCKET_REDIS_REQUIRED=false

# ---------- OTP / email verification ----------
JWT_VERIFIED_EMAIL_SECRET=
JWT_VERIFIED_EMAIL_TTL=15m
OTP_TTL_SECONDS=300
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_PER_EMAIL_COOLDOWN_SECONDS=60
OTP_PER_EMAIL_HOURLY_LIMIT=5
OTP_VERIFIED_EMAIL_SKIP_DAYS=7

# ---------- SMTP ----------
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---------- PayOS ----------
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=http://localhost:3000/payment/success
PAYOS_CANCEL_URL=http://localhost:3000/payment/cancel
PAYOS_WEBHOOK_URL=

# ---------- Booking rules ----------
MAX_ACTIVE_BOOKINGS_PER_CUSTOMER=3
MAX_RESCHEDULES=2
BOOKING_PAYMENT_TIMEOUT_MINUTES=15
CASH_ARRIVAL_GRACE_MINUTES=30
BOOKING_SLOT_INTERVAL_MINUTES=30
IDEMPOTENCY_TTL_SECONDS=86400

# ---------- Cloudinary ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- Google Sign-In ----------
# From Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client
# ID (type: Web application). Leave blank to disable both /auth/google routes;
# they answer 503 rather than half-working.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must be listed verbatim under "Authorised redirect URIs" on that same client,
# and must point at THIS backend (the callback runs here), not at the SPA.
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Origin of the SPA. Where the Google callback sends the browser back to, and
# the only origin an `?redirect=` parameter is allowed to name.
FRONTEND_URL=http://localhost:5173

# ---------- Gemini (chat assistant) ----------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---------- Scheduled jobs ----------
# Shared secret for /api/internal/jobs/:name. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Vercel Cron sends it automatically as `Authorization: Bearer $CRON_SECRET`
# once the variable is set on the project. Leaving it EMPTY makes the endpoint
# return 404, which silently stops every scheduled job — set it in production.
# See SCHEDULED_JOBS.md for which jobs run on Vercel vs an external cron.
CRON_SECRET=
